# Multi-Agent Workbench — model configuration (copy to .env, gitignored)
#
# Tiers are neutral in code: 'planner' (the master brain: decompose/review)
# and 'worker' (parallel execution). Point them at ANY OpenAI-compatible
# endpoints — what you configure is what runs; nothing is hardcoded.
#
# The *_LABEL vars are what the UI shows in the model dropdown (optional —
# defaults to the model id).

# planner tier (master)
PLANNER_API_KEY=
PLANNER_BASE_URL=https://your-gateway.example/v1
PLANNER_MODEL=your-model-id
PLANNER_LABEL=

# worker tier (execution) — point at the same or a different provider
WORKER_API_KEY=
WORKER_BASE_URL=https://your-gateway.example/v1
WORKER_MODEL=your-model-id
WORKER_LABEL=

# gateway port (optional)
# PORT=8787
